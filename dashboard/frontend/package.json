{
  "name": "polybtc-monitor",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "npm run content && vite --configLoader runner",
    "build": "npm run content && tsc --noEmit && vite build --configLoader runner",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "preview": "vite preview --configLoader runner --host 127.0.0.1 --port 3000 --strictPort",
    "content": "node scripts/build-content.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "markdown-it": "14.3.1",
    "motion": "^12.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.3.0"
  }
